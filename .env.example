# Optional local Long Polling mode only. Do not run bot.py alongside the Cloudflare webhook for the same token.
TELEGRAM_BOT_TOKEN=replace_with_your_token
ALLOWED_USER_IDS=
POLL_TIMEOUT=30
LOG_LEVEL=INFO

# Local Bridge configuration. The Hub must remain bound to loopback.
BRIDGE_BASE_URL=https://mr-siavash-el-ir-bot.mrsiavashirbot.workers.dev
HUB_API_BASE_URL=http://127.0.0.1:8000
HUB_CLIENT_ID=3a1c9d72-6f84-4b35-9e21-7d0c8a6f4b52
TELEGRAM_OWNER_ID=
# Store BRIDGE_SHARED_SECRET with: python bridge.py --init-secret
# Do not keep the shared secret in this file after initialization.
