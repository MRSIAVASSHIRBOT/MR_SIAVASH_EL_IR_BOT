# Local-only Telegram credentials. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace_with_your_token

# First run: leave empty, send /id to the bot, then add your numeric user ID.
# Example: ALLOWED_USER_IDS=123456789
ALLOWED_USER_IDS=

# Valid range: 1-50 seconds.
POLL_TIMEOUT=30
LOG_LEVEL=INFO
